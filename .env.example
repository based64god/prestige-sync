# Sanity API token with Editor rights (sanity.io/manage -> project -> API -> Tokens).
# Leave unset to use the Studio login saved by `npx sanity login`.
SANITY_API_TOKEN=

# Optional overrides
#SANITY_PROJECT_ID=k00wzpm0
#SANITY_DATASET=production
#WOM_GROUP_ID=12355          # default: siteSettings.womGroupId
#WOM_API_KEY=                # raises the WOM rate limit
#WOM_USER_AGENT=             # WOM asks for a contact handle here
